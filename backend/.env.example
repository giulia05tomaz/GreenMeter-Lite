APP_NAME="GreenMeter Lite"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=greenmeter
DB_USERNAME=greenmeter
DB_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional local-only demo account. Leave blank in shared or production environments.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
